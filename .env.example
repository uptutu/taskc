# TaskC Environment Configuration
# Copy this file to .env and modify values as needed

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=taskc_user
DB_PASSWORD=taskc_password_2024
DB_NAME=taskc

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Log Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90
LOG_CLEANUP_TIME=02:00
LOG_DISK_THRESHOLD=85

# Heartbeat Configuration
HEARTBEAT_TIMEOUT=20s
HEARTBEAT_CHECK_INTERVAL=5s
HEARTBEAT_MAX_MISSED_BEATS=2

# Alert Configuration
# SMS
SMS_ENABLED=true
SMS_RATE_LIMIT=30
SMS_PROVIDER=twilio
SMS_API_KEY=your-twilio-api-key
SMS_API_SECRET=your-twilio-api-secret

# Email
EMAIL_ENABLED=true
EMAIL_RATE_LIMIT=100
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@taskc.example.com

# Slack
SLACK_ENABLED=true
SLACK_RATE_LIMIT=20
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK